<% content_for(:title) { "#{@food_fund.name} — Materia Prima" } %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h1 class="h3 mb-0"><%= @food_fund.name %></h1>
    <% if @food_fund.description.present? %>
      <p class="text-muted mb-0"><%= @food_fund.description %></p>
    <% end %>
  </div>
  <div class="d-flex gap-2">
    <% if @subscribed %>
      <%= link_to "Log Spending", new_food_fund_spending_path(@food_fund), class: "btn btn-success" %>
      <%= button_to "Leave Fund", food_fund_subscription_path(@food_fund), method: :delete, class: "btn btn-outline-danger btn-sm" %>
    <% else %>
      <%= button_to "Join Fund", food_fund_subscription_path(@food_fund), method: :post, class: "btn btn-primary" %>
    <% end %>
    <% if admin? %>
      <%= link_to "Edit", edit_food_fund_path(@food_fund), class: "btn btn-outline-secondary btn-sm" %>
      <%= button_to "Delete", @food_fund, method: :delete, class: "btn btn-outline-danger btn-sm",
                    data: { turbo_confirm: "Delete this food fund?" } %>
    <% end %>
  </div>
</div>

<!-- Stats row -->
<div class="row g-3 mb-4">
  <div class="col-sm-4">
    <div class="card text-center border-0 bg-white shadow-sm">
      <div class="card-body">
        <div class="fs-4 fw-bold text-dark">€<%= number_with_precision(@food_fund.total_spent, precision: 2) %></div>
        <div class="text-muted small">Total fund spending</div>
      </div>
    </div>
  </div>
  <div class="col-sm-4">
    <div class="card text-center border-0 bg-white shadow-sm">
      <div class="card-body">
        <div class="fs-4 fw-bold text-success">€<%= number_with_precision(@my_total, precision: 2) %></div>
        <div class="text-muted small">Your contribution</div>
      </div>
    </div>
  </div>
  <div class="col-sm-4">
    <div class="card text-center border-0 bg-white shadow-sm">
      <div class="card-body">
        <div class="fs-4 fw-bold text-primary"><%= @food_fund.users.count %></div>
        <div class="text-muted small">Members</div>
      </div>
    </div>
  </div>
</div>

<!-- Next payer banner -->
<% if @next_payer.present? %>
  <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
    <span class="fs-4 me-3">🎯</span>
    <div>
      <strong>Next up to pay:</strong>
      <span class="fs-5 ms-2"><%= @next_payer.name %></span>
      <% if @next_payer == current_user %>
        <span class="badge bg-danger ms-2">That's you!</span>
      <% end %>
    </div>
  </div>
<% end %>

<div class="row g-4">
  <!-- Spending history -->
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-header bg-dark text-white">
        <h5 class="mb-0">💸 Spending History</h5>
      </div>
      <div class="card-body p-0">
        <% if @spendings.any? %>
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Who</th>
                <th>Amount</th>
                <th>Description</th>
                <th>When</th>
              </tr>
            </thead>
            <tbody>
              <% @spendings.each do |spending| %>
                <tr>
                  <td><%= spending.user.name %></td>
                  <td class="fw-semibold">€<%= number_with_precision(spending.amount, precision: 2) %></td>
                  <td class="text-muted"><%= spending.description.presence || "—" %></td>
                  <td class="text-muted small"><%= spending.created_at.strftime("%d %b %Y") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-muted p-3 mb-0">No spendings logged yet. Be the first!</p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Members sidebar -->
  <div class="col-lg-4">
    <div class="card shadow-sm">
      <div class="card-header bg-secondary text-white">
        <h5 class="mb-0">👥 Members</h5>
      </div>
      <ul class="list-group list-group-flush">
        <% @food_fund.users.order("subscriptions.created_at ASC").each do |user| %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <%= user.name %>
            <span class="badge bg-light text-dark">
              €<%= number_with_precision(user.total_spent_on(@food_fund), precision: 2) %>
            </span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
