<%= form_with model: food_fund, class: "needs-validation" do |f| %>
  <% if food_fund.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% food_fund.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control #{"is-invalid" if food_fund.errors[:name].any?}", autofocus: true %>
  </div>

  <div class="mb-4">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, rows: 3, class: "form-control", placeholder: "Optional description…" %>
  </div>

  <%= f.submit class: "btn btn-dark" %>
  <%= link_to "Cancel", food_funds_path, class: "btn btn-outline-secondary ms-2" %>
<% end %>
