<%= form_with model: user do |f| %>
  <% if user.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", autofocus: true %>
  </div>

  <div class="mb-3">
    <%= f.label :email, class: "form-label" %>
    <%= f.email_field :email, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :password, user.new_record? ? "Password" : "New Password (leave blank to keep)", class: "form-label" %>
    <%= f.password_field :password, class: "form-control", autocomplete: "new-password" %>
  </div>

  <div class="mb-3">
    <%= f.label :password_confirmation, class: "form-label" %>
    <%= f.password_field :password_confirmation, class: "form-control" %>
  </div>

  <div class="mb-4 form-check">
    <%= f.check_box :admin, class: "form-check-input" %>
    <%= f.label :admin, "Admin privileges", class: "form-check-label" %>
  </div>

  <%= f.submit user.new_record? ? "Create User" : "Save Changes", class: "btn btn-dark" %>
  <%= link_to "Cancel", users_path, class: "btn btn-outline-secondary ms-2" %>
<% end %>
